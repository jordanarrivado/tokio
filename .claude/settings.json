{
  "permissions": {
    "allow": [
      "Edit",
      "Write"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(.env/**)",
      "Read(.npmrc)",
      "Read(credential)",
      "Read(credential.*)",
      "Read(credential/**)",
      "Read(credentials)",
      "Read(credentials.*)",
      "Read(credentials/**)",
      "Read(secret)",
      "Read(secret.*)",
      "Read(secret/**)",
      "Read(secrets)",
      "Read(secrets.*)",
      "Read(secrets/**)",
      "Read(*.key)",  
      "Read(*.pem)",
      "Read(*.p12)",
      "Read(*.pfx)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|Grep|Glob|Bash|PowerShell|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/projects/tokio/out/broker/cli.js hook"
          }
        ]
      }
    ]
  }
}